---
import { frontmatter } from "../content/index.md";
---

<section id="about" class="container-wide py-24">
  <div class="grid gap-14 lg:grid-cols-[.8fr_1.2fr]">
    <div>
      <p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.about.eyebrow}</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">{frontmatter.about.title}</h2>
    </div>
    <div class="max-w-2xl">
      <p class="text-xl font-bold leading-9">{frontmatter.about.lead}</p>
      <p class="mt-5 leading-8 text-slate-600">{frontmatter.about.text}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {frontmatter.about.features.map((feature) => (
          <div class="rounded-2xl bg-slate-100 p-5"><p class="text-2xl">{feature.icon}</p><p class="mt-3 font-black">{feature.title}</p><p class="mt-1 text-sm text-slate-500">{feature.text}</p></div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="location" class="border-y border-slate-200 bg-slate-50 py-24">
  <div class="container-wide grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
    <div>
      <p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.location.eyebrow}</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">{frontmatter.location.title}</h2>
      <p class="mt-6 text-2xl font-black leading-relaxed">{frontmatter.location.venue}</p>
    </div>
    <div class="rounded-3xl bg-white p-7 shadow-sm sm:p-9">
      <div class="flex gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-lime-200 text-xl">🚉</span>
        <div><p class="font-black">アクセス</p><p class="mt-1 leading-7 text-slate-600">{frontmatter.location.access}</p></div>
      </div>
      <div class="mt-6 flex gap-4 border-t border-slate-100 pt-6">
        <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-teal-100 text-xl">🚗</span>
        <div><p class="font-black">お車でお越しの方へ</p><p class="mt-1 leading-7 text-slate-600">{frontmatter.location.parking}</p></div>
      </div>
      <a href={frontmatter.location.mapUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex rounded-full bg-teal-700 px-5 py-3 font-bold text-white hover:bg-teal-800">{frontmatter.location.mapLinkText}</a>
    </div>
  </div>
</section>
