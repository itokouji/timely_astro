---
import Layout from "../layouts/Layout.astro";
import { frontmatter } from "../content/index.md";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title={frontmatter.title}>
  <section class="hero-grid overflow-hidden bg-slate-950 text-white">
    <div class="container-wide grid min-h-[620px] items-center gap-12 py-20 lg:grid-cols-[1.15fr_.85fr]">
      <div>
        <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-bold tracking-[.18em] text-lime-300">{frontmatter.hero.eyebrow}</div>
        <h1 class="max-w-3xl text-5xl font-black leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">{frontmatter.hero.title}</h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-slate-300 sm:text-lg">{frontmatter.hero.description}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#join" class="rounded-full bg-lime-300 px-6 py-3.5 font-black text-slate-950 hover:bg-lime-200">参加してみる →</a>
          <a href={`${base}schedule`} class="rounded-full border border-white/20 px-6 py-3.5 font-bold hover:bg-white/10">練習スケジュール</a>
        </div>
      </div>

      <div class="relative hidden min-h-[420px] items-center justify-center lg:flex">
        <div class="absolute size-80 rounded-full bg-teal-500/20 blur-3xl"></div>
        <div class="relative grid size-72 place-items-center rounded-[40%] border border-white/10 bg-white/5 shadow-2xl backdrop-blur">
          <div class="shuttle text-lime-300"></div>
          <span class="absolute bottom-8 right-8 rounded-full bg-white px-4 py-2 text-xs font-black text-slate-950">TIMELY</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div class="container-wide grid gap-6 py-7 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.nextPractice.label}</p>
        <p class="mt-2 text-xl font-black">{frontmatter.nextPractice.text}</p>
      </div>
      <a href={`${base}schedule`} class="font-bold text-teal-700">{frontmatter.nextPractice.linkText}</a>
    </div>
  </section>

  <section id="about" class="container-wide py-24">
    <div class="grid gap-14 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.about.eyebrow}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">{frontmatter.about.title}</h2>
      </div>
      <div class="max-w-2xl">
        <p class="text-xl font-bold leading-9">{frontmatter.about.lead}</p>
        <p class="mt-5 leading-8 text-slate-600">{frontmatter.about.text}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {frontmatter.about.features.map((feature) => (
            <div class="rounded-2xl bg-slate-100 p-5"><p class="text-2xl">{feature.icon}</p><p class="mt-3 font-black">{feature.title}</p><p class="mt-1 text-sm text-slate-500">{feature.text}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="location" class="border-y border-slate-200 bg-slate-50 py-24">
    <div class="container-wide grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
      <div>
        <p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.location.eyebrow}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">{frontmatter.location.title}</h2>
        <p class="mt-6 text-2xl font-black leading-relaxed">{frontmatter.location.venue}</p>
      </div>
      <div class="rounded-3xl bg-white p-7 shadow-sm sm:p-9">
        <div class="flex gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-lime-200 text-xl">🚉</span>
          <div><p class="font-black">アクセス</p><p class="mt-1 leading-7 text-slate-600">{frontmatter.location.access}</p></div>
        </div>
        <div class="mt-6 flex gap-4 border-t border-slate-100 pt-6">
          <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-teal-100 text-xl">🚗</span>
          <div><p class="font-black">お車でお越しの方へ</p><p class="mt-1 leading-7 text-slate-600">{frontmatter.location.parking}</p></div>
        </div>
        <a href={frontmatter.location.mapUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex rounded-full bg-teal-700 px-5 py-3 font-bold text-white hover:bg-teal-800">{frontmatter.location.mapLinkText}</a>
      </div>
    </div>
  </section>

  <section class="bg-slate-100 py-24">
    <div class="container-wide">
      <div class="flex items-end justify-between gap-6">
        <div><p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.schedule.eyebrow}</p><h2 class="mt-3 text-4xl font-black tracking-tight">{frontmatter.schedule.title}</h2></div>
        <a class="hidden font-bold text-teal-700 sm:block" href={`${base}schedule`}>{frontmatter.schedule.linkText}</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {frontmatter.practices.map((p) => (
          <article class="card-lift rounded-3xl bg-white p-7 shadow-sm">
            <div class="flex items-end justify-between"><span class="text-5xl font-black tracking-tight">{p.date}</span><span class="rounded-full bg-lime-200 px-3 py-1 text-xs font-black">{p.day}</span></div>
            <div class="mt-8 border-t border-slate-100 pt-5"><p class="font-bold">{p.place}</p><p class="mt-2 text-sm text-slate-500">{p.time}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide py-24">
    <div class="flex items-end justify-between gap-6">
      <div><p class="text-xs font-black tracking-[.2em] text-teal-700">{frontmatter.newsSection.eyebrow}</p><h2 class="mt-3 text-4xl font-black tracking-tight">{frontmatter.newsSection.title}</h2></div>
      <a class="font-bold text-teal-700" href={`${base}news`}>{frontmatter.newsSection.linkText}</a>
    </div>
    <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {frontmatter.news.map((item) => (
        <article class="grid gap-2 py-6 sm:grid-cols-[150px_1fr]">
          <p class="text-sm font-bold text-slate-400">{item.date}</p>
          <div><h3 class="font-black">{item.title}</h3><p class="mt-2 text-sm leading-7 text-slate-600">{item.text}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section id="join" class="container-wide pb-24">
    <div class="overflow-hidden rounded-[32px] bg-teal-700 px-7 py-12 text-white sm:px-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
        <div><p class="text-xs font-black tracking-[.2em] text-lime-300">{frontmatter.join.eyebrow}</p><h2 class="mt-3 text-4xl font-black sm:text-5xl">{frontmatter.join.title}</h2><p class="mt-5 max-w-xl leading-8 text-teal-50">{frontmatter.join.text}</p></div>
        <div class="flex flex-wrap gap-3"><a href={`${base}schedule`} class="rounded-full bg-lime-300 px-6 py-3.5 font-black text-slate-950">{frontmatter.join.scheduleLinkText}</a><a href={`${base}about`} class="rounded-full border border-white/30 px-6 py-3.5 font-bold">{frontmatter.join.aboutLinkText}</a></div>
      </div>
    </div>
  </section>
</Layout>
