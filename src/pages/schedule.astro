---
import Layout from "../layouts/Layout.astro";
import { frontmatter } from "../content/schedule.md";
---

<Layout title={frontmatter.title} description={frontmatter.hero.description}>
  <section class="bg-slate-950 py-20 text-white">
    <div class="container-wide"><p class="text-xs font-black tracking-[.2em] text-lime-300">{frontmatter.hero.eyebrow}</p><h1 class="mt-3 text-5xl font-black">{frontmatter.hero.title}</h1><p class="mt-5 text-slate-300">{frontmatter.hero.description}</p></div>
  </section>
  <section class="container-wide py-16">
    <div class="space-y-4">
      {frontmatter.practices.map((p) => (
        <article class="card-lift grid gap-5 rounded-3xl border border-slate-200 bg-white p-7 sm:grid-cols-[150px_1fr_auto] sm:items-center">
          <div><span class="text-4xl font-black">{p.date}</span><span class="ml-3 rounded-full bg-lime-200 px-2.5 py-1 text-xs font-black">{p.day}</span></div>
          <div><p class="font-black">{p.place}</p><p class="mt-1 text-sm text-slate-500">{p.time}</p></div>
          <span class="text-sm font-bold text-teal-700">練習予定</span>
        </article>
      ))}
    </div>
  </section>
</Layout>
