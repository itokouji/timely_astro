---
import Layout from "../layouts/Layout.astro";
import { frontmatter } from "../content/news.md";
---

<Layout title={frontmatter.title} description={frontmatter.hero.description}>
  <section class="bg-slate-950 py-20 text-white">
    <div class="container-wide"><p class="text-xs font-black tracking-[.2em] text-lime-300">{frontmatter.hero.eyebrow}</p><h1 class="mt-3 text-5xl font-black">{frontmatter.hero.title}</h1></div>
  </section>
  <section class="container-wide py-16">
    <div class="divide-y divide-slate-200 border-y border-slate-200">
      {frontmatter.items.map((item) => (
        <article class="grid gap-3 py-8 sm:grid-cols-[150px_1fr]">
          <p class="text-sm font-bold text-slate-400">{item.date}</p>
          <div><h2 class="text-xl font-black">{item.title}</h2><p class="mt-3 leading-8 text-slate-600">{item.text}</p></div>
        </article>
      ))}
    </div>
  </section>
</Layout>
