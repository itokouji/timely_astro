---
import "../styles/global.css";
import { frontmatter as site } from "../content/site.md";

const { title = "タイムリーバドミントンクラブ", description = "東京都稲城市を中心に活動するバドミントンクラブ" } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBasePath = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const navItems = site.nav as { href: string; label: string }[];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!--
    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
     -->
    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
      <div class="container-wide flex h-18 items-center justify-between gap-6">
        <a href={withBasePath("/")} class="flex items-center gap-3 font-black tracking-tight">
          <span class="grid size-10 place-items-center rounded-xl bg-teal-700 text-xl text-white">T</span>
          <span>
            <span class="block text-sm tracking-[.18em] text-teal-700">{site.shortName}</span>
            <span class="block text-lg leading-5">{site.logoText}</span>
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-bold md:flex">
          {navItems.map((item) => <a class="hover:text-teal-700" href={withBasePath(item.href)}>{item.label}</a>)}
          <a class="rounded-full bg-slate-900 px-5 py-2.5 text-white hover:bg-teal-700" href={withBasePath(site.join.href)}>{site.join.label}</a>
        </nav>
        <a class="rounded-full bg-slate-900 px-4 py-2 text-sm font-bold text-white md:hidden" href={withBasePath(site.join.href)}>{site.join.shortLabel}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 bg-slate-950 text-slate-300">
      <div class="container-wide grid gap-10 py-14 md:grid-cols-3">
        <div>
          <p class="text-xs font-bold tracking-[.25em] text-lime-300">{site.shortName} {site.logoText}</p>
          <h2 class="mt-3 text-2xl font-black text-white">{site.footer.tagline}</h2>
        </div>
        <div>
          <p class="font-bold text-white">{site.footer.navigationTitle}</p>
          <div class="mt-4 space-y-2 text-sm">
            {navItems.map((item) => <a class="block hover:text-white" href={withBasePath(item.href)}>{item.label}</a>)}
          </div>
        </div>
        <div>
          <p class="font-bold text-white">{site.footer.locationTitle}</p>
          <p class="mt-4 text-sm leading-7">{site.footer.location}</p>
        </div>
      </div>
      <div class="border-t border-white/10 py-6 text-center text-xs">{site.footer.copyright}</div>
    </footer>
  </body>
</html>
